  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Plain outlined control; fills with ink on press.",
      "html": "<button class=\"ds-btn\">Show archived</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn:hover,.ds-btn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-btn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Same control in meter blue; one per view.",
      "html": "<button class=\"ds-btn ds-btn-primary\">New counter</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn:hover,.ds-btn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-btn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}.ds-btn-primary{border-color:var(--accent,#1f5f8b);color:var(--accent,#1f5f8b)}.ds-btn-primary:hover,.ds-btn-primary:active{background:var(--accent,#1f5f8b);color:var(--page,#eceff1)}"
    },
    {
      "name": "Header Plate",
      "kind": "nav",
      "refersTo": "header-plate",
      "description": "Meter-blue plate with the condensed wordmark; theme toggle and menu icons stay white on it.",
      "html": "<header class=\"ds-plate\"><span class=\"ds-plate-name\">Countsy</span></header>",
      "css": ".ds-plate{background:var(--plate,#1f5f8b);color:#fff;padding:8px 16px}.ds-plate-name{font:700 30px 'Barlow Condensed',sans-serif;letter-spacing:.1em;text-transform:uppercase}"
    },
    {
      "name": "Counter Card",
      "kind": "card",
      "refersTo": "counter-card",
      "description": "Full-width title row (title, edit and archive icons at 48px), optional two-line description, then register, goal line and minus/plus pair.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-head\"><span class=\"ds-card-title\">Water</span><button class=\"ds-icon\" aria-label=\"Edit Water\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 21h8\"/><path d=\"M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z\"/></svg></button><button class=\"ds-icon\" aria-label=\"Archive Water\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"5\" x=\"2\" y=\"3\" rx=\"1\"/><path d=\"M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8\"/><path d=\"M10 12h4\"/></svg></button></div><p class=\"ds-card-desc\">Glasses a day, counted at the tap.</p><div class=\"ds-card-body\"><div class=\"ds-goal\">of 8</div></div></article>",
      "css": ".ds-card{background:var(--surface,#f8fafb);border:1px solid var(--line,#b9c3ca);border-radius:2px;max-width:340px}.ds-card-head{display:flex;align-items:flex-start;gap:4px;padding:8px 4px 0 16px}.ds-card-title{flex:1;display:flex;align-items:center;min-height:48px;font:600 20px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--accent,#1f5f8b)}.ds-icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border:0;border-radius:2px;background:transparent;color:var(--ink-muted,#46515a);cursor:pointer;transition:color .15s}.ds-icon:hover{color:var(--ink,#14181c)}.ds-icon:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}.ds-card-desc{margin:0;padding:0 28px 0 16px;font:400 16px/1.375 Barlow,sans-serif;color:var(--ink-muted,#46515a);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-card-body{padding:12px 16px 16px}.ds-goal{height:24px;font:500 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted,#46515a)}"
    },
    {
      "name": "Drum Register",
      "kind": "custom",
      "refersTo": "drum-tile",
      "description": "One black tile per digit, uniform light digits.",
      "html": "<div class=\"ds-drum\"><span class=\"ds-tile\">0</span><span class=\"ds-tile\">0</span><span class=\"ds-tile\">4</span><span class=\"ds-tile\">2</span></div>",
      "css": ".ds-drum{display:flex;gap:3px;font:600 74px/1 Barlow,sans-serif;font-variant-numeric:tabular-nums}.ds-tile{position:relative;display:flex;align-items:center;justify-content:center;width:.7em;height:1.3em;border-radius:.06em;background:var(--tile,#0d1114);color:var(--tile-ink,#eceff1);overflow:hidden}.ds-tile::after{content:'';position:absolute;left:0;right:0;top:50%;height:1px;background:currentColor;opacity:.15}"
    },
    {
      "name": "Goal Gauge",
      "kind": "custom",
      "refersTo": "counter-card",
      "description": "Narrow open-topped glass that starts below the title row and runs beside the register, goal line and minus/plus pair: brim line at 94% marks the goal, short marks at a quarter, half and three quarters; water fills to the brim at the goal and tops up past it; glass turns meter blue once reached.",
      "html": "<div style=\"display:flex;gap:24px\"><div class=\"ds-gauge\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"8\" aria-valuenow=\"5\" aria-label=\"5 of 8\"><div class=\"ds-gauge-water\" style=\"height:59%\"></div><div class=\"ds-gauge-lip\"></div><div class=\"ds-gauge-mark\" style=\"bottom:23.5%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:47%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:70.5%\"></div><div class=\"ds-gauge-brim\"></div></div><div class=\"ds-gauge ds-gauge-reached\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"8\" aria-valuenow=\"8\" aria-label=\"8 of 8, goal reached\"><div class=\"ds-gauge-water\" style=\"height:94%\"></div><div class=\"ds-gauge-lip\"></div><div class=\"ds-gauge-mark\" style=\"bottom:23.5%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:47%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:70.5%\"></div><div class=\"ds-gauge-brim\"></div></div></div>",
      "css": ".ds-gauge{position:relative;width:14px;height:160px;border:2px solid var(--ink-muted,#46515a);border-top:0;border-radius:0 0 3px 3px;transition:border-color .2s}.ds-gauge-water{position:absolute;left:0;right:0;bottom:0;background:color-mix(in srgb,var(--accent,#1f5f8b) 85%,transparent);border-top:2px solid var(--accent,#1f5f8b);transition:height 180ms ease-out}.ds-gauge-lip{position:absolute;top:-1px;left:-2px;right:-6px;height:2px;background:var(--ink-muted,#46515a)}.ds-gauge-mark{position:absolute;right:0;width:40%;height:1px;background:var(--ink-muted,#46515a)}.ds-gauge-brim{position:absolute;right:0;bottom:94%;width:50%;height:2px;background:var(--ink-muted,#46515a)}.ds-gauge-reached{border-color:var(--accent,#1f5f8b)}.ds-gauge-reached .ds-gauge-lip,.ds-gauge-reached .ds-gauge-mark,.ds-gauge-reached .ds-gauge-brim{background:var(--accent,#1f5f8b)}@media (prefers-reduced-motion:reduce){.ds-gauge-water{transition:none}}"
    },
    {
      "name": "Archived Card Footer",
      "kind": "card",
      "refersTo": "counter-card",
      "description": "Archived cards are read-only: \"Archived\" on the goal line and outlined Restore / Delete in place of minus/plus. Delete is never red.",
      "html": "<div class=\"ds-arch\"><div class=\"ds-arch-goal\">of 8 <b>Archived</b></div><div class=\"ds-arch-pair\"><button class=\"ds-arch-btn\">Restore</button><button class=\"ds-arch-btn\">Delete</button></div></div>",
      "css": ".ds-arch{max-width:300px;padding:12px 16px 16px;background:var(--surface,#f8fafb);border:1px solid var(--line,#b9c3ca);border-radius:2px}.ds-arch-goal{height:24px;font:500 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted,#46515a)}.ds-arch-goal b{font-weight:600;margin-left:12px}.ds-arch-pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding-top:8px}.ds-arch-btn{min-height:50px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-arch-btn:hover,.ds-arch-btn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-arch-btn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}"
    },
    {
      "name": "Confirm Dialog",
      "kind": "custom",
      "refersTo": "confirm-dialog",
      "description": "Archive and delete confirmation: Porcelain, 2px hairline border, 2px corners, 50% black backdrop, no shadow; Cancel takes focus first, confirm is the primary.",
      "html": "<div class=\"ds-scrim\"><div class=\"ds-dialog\" role=\"dialog\" aria-labelledby=\"ds-dh\"><h2 id=\"ds-dh\" class=\"ds-dialog-h\">Delete this counter?</h2><p class=\"ds-dialog-p\"><b>Coffee cups</b> and its count of 12 will be deleted. This can't be undone.</p><div class=\"ds-dialog-actions\"><button class=\"ds-dbtn\">Cancel</button><button class=\"ds-dbtn ds-dbtn-primary\">Delete</button></div></div></div>",
      "css": ".ds-scrim{padding:24px;background:rgb(0 0 0/.5)}.ds-dialog{max-width:28rem;margin:auto;padding:24px;background:var(--surface,#f8fafb);color:var(--ink,#14181c);border:2px solid var(--line,#b9c3ca);border-radius:2px}.ds-dialog-h{margin:0;font:600 20px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--accent,#1f5f8b)}.ds-dialog-p{margin:0;padding:16px 0;font:400 16px/1.5 Barlow,sans-serif}.ds-dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}.ds-dbtn{min-height:48px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-dbtn:hover,.ds-dbtn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-dbtn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}.ds-dbtn-primary{border-color:var(--accent,#1f5f8b);color:var(--accent,#1f5f8b)}.ds-dbtn-primary:hover,.ds-dbtn-primary:active{background:var(--accent,#1f5f8b);color:var(--page,#eceff1)}"
    },
    {
      "name": "Edit Form Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field in the 36rem form card: meter-blue condensed label, Porcelain field with 2px muted outline, tabular numerals for numbers, Ink semibold error under the field.",
      "html": "<div class=\"ds-form\"><div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-goal\">Goal (optional)</label><input id=\"ds-goal\" class=\"ds-input ds-num\" type=\"number\" value=\"0\" aria-invalid=\"true\" aria-describedby=\"ds-goal-msg\"><p id=\"ds-goal-msg\" class=\"ds-err\">Enter a whole number above 0, or leave it empty.</p></div></div>",
      "css": ".ds-form{max-width:36rem;padding:24px;background:var(--surface,#f8fafb);border:1px solid var(--line,#b9c3ca);border-radius:2px}.ds-field{display:flex;flex-direction:column;gap:4px}.ds-label{font:600 16px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--accent,#1f5f8b)}.ds-input{min-height:48px;padding:8px 12px;border:2px solid var(--ink-muted,#46515a);border-radius:2px;background:var(--surface,#f8fafb);color:var(--ink,#14181c);font:18px Barlow,sans-serif;caret-color:var(--accent,#1f5f8b)}.ds-input:focus-visible{border-color:var(--accent,#1f5f8b);outline:3px solid var(--accent,#1f5f8b);outline-offset:1px}.ds-num{font-variant-numeric:tabular-nums}.ds-err{margin:0;font:600 16px Barlow,sans-serif;color:var(--ink,#14181c)}"
    },
    {
      "name": "Text Link",
      "kind": "nav",
