      "kind": "button",
      "refersTo": "button",
      "description": "Plain outlined control; fills with ink on press.",
      "html": "<button class=\"ds-btn\">Show archived</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn:hover,.ds-btn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-btn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}"
