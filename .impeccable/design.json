    {
      "name": "Counter Card",
      "kind": "card",
      "refersTo": "counter-card",
      "description": "Title, register, goal line and a minus/plus pair.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-title\">Water</div><div class=\"ds-goal\">of 8</div></article>",
      "css": ".ds-card{background:var(--surface,#f8fafb);border:1px solid var(--line,#b9c3ca);border-radius:2px;padding:0 16px 16px}.ds-card-title{padding-top:12px;font:600 20px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--accent,#1f5f8b)}.ds-goal{margin-top:8px;font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted,#46515a)}"
    },
    {
      "name": "Goal Gauge",
      "kind": "custom",
      "refersTo": "counter-card",
      "description": "Narrow open-topped glass down the card's right edge: brim line at 94% marks the goal, short marks at a quarter, half and three quarters; water fills to the brim at the goal and tops up past it; glass turns meter blue once reached.",
      "html": "<div style=\"display:flex;gap:24px\"><div class=\"ds-gauge\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"8\" aria-valuenow=\"5\" aria-label=\"5 of 8\"><div class=\"ds-gauge-water\" style=\"height:59%\"></div><div class=\"ds-gauge-lip\"></div><div class=\"ds-gauge-mark\" style=\"bottom:23.5%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:47%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:70.5%\"></div><div class=\"ds-gauge-brim\"></div></div><div class=\"ds-gauge ds-gauge-reached\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"8\" aria-valuenow=\"8\" aria-label=\"8 of 8, goal reached\"><div class=\"ds-gauge-water\" style=\"height:94%\"></div><div class=\"ds-gauge-lip\"></div><div class=\"ds-gauge-mark\" style=\"bottom:23.5%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:47%\"></div><div class=\"ds-gauge-mark\" style=\"bottom:70.5%\"></div><div class=\"ds-gauge-brim\"></div></div></div>",
      "css": ".ds-gauge{position:relative;width:14px;height:160px;border:2px solid var(--ink-muted,#46515a);border-top:0;border-radius:0 0 3px 3px;transition:border-color .15s}.ds-gauge-water{position:absolute;left:0;right:0;bottom:0;background:color-mix(in srgb,var(--accent,#1f5f8b) 85%,transparent);border-top:2px solid var(--accent,#1f5f8b);transition:height 180ms ease-out}.ds-gauge-lip{position:absolute;top:-1px;left:-2px;right:-6px;height:2px;background:var(--ink-muted,#46515a)}.ds-gauge-mark{position:absolute;right:0;width:30%;height:1px;background:var(--ink-muted,#46515a)}.ds-gauge-brim{position:absolute;right:0;bottom:94%;width:50%;height:2px;background:var(--ink-muted,#46515a)}.ds-gauge-reached{border-color:var(--accent,#1f5f8b)}.ds-gauge-reached .ds-gauge-lip,.ds-gauge-reached .ds-gauge-mark,.ds-gauge-reached .ds-gauge-brim{background:var(--accent,#1f5f8b)}@media (prefers-reduced-motion:reduce){.ds-gauge-water{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Water-Meter Register",
    "overview": "A counter is a utility meter read at a glance. Countsy sets every value as a row of black drum tiles with light digits on a cool enamel-grey ground, under a single meter-blue plate. The system is flat, outlined and instrumental: nothing is decorated, and every surface exists to make the number legible first.\n\nDensity is phone-first and calm. One card per counter, one number per card, a full-width minus and plus pair beneath. Dark mode is an instrument panel, not a recolor: the ground drops to near-black and the drum tiles invert to light tiles with dark digits.",
    "keyCharacteristics": [
      "Enamel-grey ground, one blue, near-black ink; no gradients, no shadows.",
      "Condensed uppercase labels over a plain humanist body face.",
      "Outlined, square-ish controls that fill with ink on press.",
      "Numbers as uniform drum digits, never colored per digit.",
      "Red appears only as a failed-save state.",
      "Motion is action feedback only; reaching a goal is the gauge filling to its brim."
    ],
    "rules": [
      {
        "name": "The Reserved Red Rule",
        "body": "Red marks a failed save or load and nothing else. It is never an accent, a delete affordance, or a hover color.",
        "section": "colors"
      },
      {
        "name": "The One Blue Rule",
        "body": "Meter blue is the only chromatic accent. Labels, primary action, focus and the plate share it.",
        "section": "colors"
      },
      {
        "name": "The Uniform Digit Rule",
        "body": "All digits in a register share one color on one tile color. No highlighted last digit.",
        "section": "colors"
      },
      {
        "name": "The Plate Voice Rule",
        "body": "Condensed uppercase is for names and controls (titles, labels, buttons, goal line). Sentences and messages are Barlow sentence case.",
        "section": "typography"
      },
      {
        "name": "The Flat Instrument Rule",
        "body": "Surfaces stay flat at every state; hover and press change fill, never elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep all digits in a register the same color on the same tile (#0d1114 with #eceff1; inverted in dark).",
      "**Do** use Meter Blue (#1f5f8b) as the only accent and Fail Red only for failed saves and loads.",
      "**Do** use outlined controls that fill with Ink on press, minimum 48px.",
      "**Do** set names, labels and buttons in Barlow Condensed uppercase and messages in Barlow.",
      "**Do** keep surfaces flat with 2px corners and hairline borders.",
      "**Do** limit motion to the 180ms digit roll, the 180ms gauge level change, and color transitions; render everything static under reduced motion."
    ],
    "donts": [
      "**Don't** use shadows, gradients, mascots, or the neon dark look of the earlier theme.",
      "**Don't** add a second celebration, streaks, badges or other decorative motion.",
      "**Don't** color digits individually or use red for emphasis or delete actions.",
      "**Don't** use cream or warm grounds; the enamel is cool."
    ]
  }
}
