      "css": ".ds-label{display:block;font:600 16px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--accent,#1f5f8b)}.ds-input{box-sizing:border-box;width:100%;min-height:48px;padding:8px 12px;border:2px solid var(--ink-muted,#46515a);border-radius:2px;background:var(--surface,#f8fafb);color:var(--ink,#14181c);font:18px Barlow,sans-serif}.ds-input:focus-visible{border-color:var(--accent,#1f5f8b);outline:3px solid var(--accent,#1f5f8b);outline-offset:1px}"
