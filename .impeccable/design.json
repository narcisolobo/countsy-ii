      "html": "<button class=\"ds-btn ds-btn-primary\">New counter</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:8px 20px;border:2px solid var(--ink,#14181c);border-radius:2px;background:transparent;color:var(--ink,#14181c);font:600 18px 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn:hover,.ds-btn:active{background:var(--ink,#14181c);color:var(--page,#eceff1)}.ds-btn:focus-visible{outline:3px solid var(--accent,#1f5f8b);outline-offset:2px}.ds-btn-primary{border-color:var(--accent,#1f5f8b);color:var(--accent,#1f5f8b)}.ds-btn-primary:hover,.ds-btn-primary:active{background:var(--accent,#1f5f8b);color:var(--page,#eceff1)}"
    },
    {
